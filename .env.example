# =============================================================================
# Environment configuration — COPY TO .env.local AND FILL IN.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored (matched by `*.local` in .gitignore). NEVER commit
# real keys, and never paste them into chat.
#
# VITE_-prefixed vars are bundled into the browser. Anything without the
# prefix is server-only and available to Cloudflare Pages Functions as `env.*`.
# =============================================================================

# ---- Public (safe in the browser) ------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Booking API base. Leave empty to call same-origin (/api/v1/...).
VITE_BOOKING_API_URL=

# ---- Server-only (NEVER prefix with VITE_) --------------------------------
# Required for any booking that writes to the database.
SUPABASE_SERVICE_ROLE_KEY=

# OSRM routing base. Defaults to https://router.project-osrm.org when empty.
ROUTE_BASE_URL=

# ---- Payments -------------------------------------------------------------
# "none" (the default) means no gateway is wired up: card payments are
# disabled and /api/v1/payments/config reports cardEnabled: false.
# "mock" runs the local fake gateway — no network, no merchant account.
# Switch to "payfast" once the adapter is verified.
PAYMENT_PROVIDER=none

# Master switch. While this is false the card option keeps showing
# "Coming Soon" and /api/v1/payments/create-session returns 404.
PAYMENTS_CARD_ENABLED=false

# LOCAL DEVELOPMENT ONLY. The mock gateway is refused unless this is "true"
# AND the environment is not a deployed one (CONTEXT/NODE_ENV/ENVIRONMENT =
# "production", or Cloudflare's CF_PAGES=1). Leave it false everywhere else.
PAYMENTS_ALLOW_MOCK=false

# Shared webhook secret for the mock provider (any non-empty string).
# Server-only. Never prefix with VITE_.
PAYMENT_WEBHOOK_SECRET=

# --- PayFast ---------------------------------------------------------------
# Sandbox first. PAYFAST_SANDBOX=true shows the TEST banner in the UI.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# --- Safepay (adapter not implemented yet) ---------------------------------
SAFEPAY_SANDBOX=true
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
