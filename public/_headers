# Long-cache for Vite's hashed assets (content hash in filename).
# stale-while-revalidate lets edge revalidate in the background so a stale
# SPA-fallback cached during a deploy window doesn't lock in for a year.
/assets/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800

# Favicons — 24h cache
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon-48.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# Long-cache for other static media (images, fonts, favicon) — revalidate weekly
/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

# OpenAPI spec — short cache, correct content type
/api/v1/openapi.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# HTML should always revalidate (entry point serves the latest built assets)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Global security headers (applied to every response)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
