# Long-cache for Vite's hashed assets (content hash in filename).
# stale-while-revalidate lets edge revalidate in the background so a stale
# SPA-fallback cached during a deploy window doesn't lock in for a year.
/assets/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800

# Static media — long cache, revalidate weekly.
# (Scoped to one path segment so it can't shadow the root favicon rules.)
/og-image.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800

# Favicons — short cache so redesigns propagate quickly.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon-48.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# OpenAPI spec — short cache, correct content type
/api/v1/openapi.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# HTML should always revalidate (entry point serves the latest built assets)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Global security headers (applied to every response)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
