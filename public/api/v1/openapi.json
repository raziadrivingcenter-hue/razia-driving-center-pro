{
  "openapi": "3.0.3",
  "info": {
    "title": "Razia Driving Center — Booking API",
    "description": "REST API for AI booking agents to check availability, calculate fees, and submit driving course reservations for Razia Driving Center, Lahore.\n\n**Base URL:** `https://raziadrivingcenter.com`\n\n**Slot System:**\n- 30-minute training slots, operating hours 8:00 AM – 8:00 PM\n- Travel buffer: distance_km × 5 minutes each way\n- A booking blocks (slot_time − travel_time) to (slot_time + 30 min) for EVERY day of the course\n- Example: 12:30 slot, 3km distance → blocked 12:15–13:00 for all course days\n- Multi-day: a 10-day PLUS Plan blocks the same time slot for all 10 days\n\n**Pricing Formula:**\n- Distance Fee = chargeable_km × 50 PKR × total_days × 2 (round trip)\n- PLUS Plan: first 2 km FREE\n- Max distance: 20 km",
    "version": "2.0.0",
    "contact": {
      "name": "Razia Driving Center",
      "phone": "+92 309 4461407",
      "whatsapp": "https://wa.me/923094461407",
      "address": "28/A, S Block, Gulberg 2, Lahore, 54660, Pakistan"
    }
  },
  "servers": [
    {
      "url": "https://raziadrivingcenter.com",
      "description": "Production"
    }
  ],
  "paths": {
    "/api/v1/availability": {
      "get": {
        "operationId": "getAvailability",
        "summary": "Get available slots for a date",
        "description": "Returns all 30-minute time slots for the given date. Slots blocked by multi-day bookings (with travel buffer) are marked as unavailable.",
        "tags": ["Availability"],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Date in YYYY-MM-DD format",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-15"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Slot availability for the date",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                },
                "example": {
                  "date": "2026-10-15",
                  "operating_hours": { "start": "08:00", "end": "20:00" },
                  "slot_duration_min": 30,
                  "available_slots": [
                    { "time": "08:00:00", "display": "8:00 AM" },
                    { "time": "08:30:00", "display": "8:30 AM" }
                  ],
                  "blocked_slots": [
                    { "time": "12:30:00", "display": "12:30 PM", "reason": "Booked" }
                  ],
                  "total_slots": 24,
                  "available_count": 22,
                  "blocked_count": 2
                }
              }
            }
          },
          "400": {
            "description": "Invalid date",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/bookings": {
      "post": {
        "operationId": "createBooking",
        "summary": "Submit a booking (multi-day slot system)",
        "description": "Creates a booking that blocks the chosen time slot for every day of the course duration. Checks for conflicts across the full date range including travel buffers.",
        "tags": ["Bookings"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BookingRequest" },
              "example": {
                "customer_name": "Ahmed Khan",
                "phone_number": "0300-1234567",
                "slot_time": "12:30",
                "course_start_date": "2026-10-15",
                "duration_days": 10,
                "plan_type": "plus",
                "distance_km": 3,
                "pickup_address": "House 123, Gulberg III, Lahore",
                "area": "Gulberg",
                "course_fee": 14500,
                "distance_fee": 3000,
                "total_fee": 17500
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookingResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationError" }
              }
            }
          },
          "409": {
            "description": "Slot conflict — time already booked for one or more course days",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConflictResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/calculate-fee": {
      "post": {
        "operationId": "calculateFee",
        "summary": "Calculate driving course fee",
        "description": "Computes total payable including pick & drop charges. PLUS Plan gets first 2 km free.",
        "tags": ["Pricing"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CalculateFeeRequest" },
              "examples": {
                "plusPlan": {
                  "summary": "PLUS Plan, 5 km",
                  "value": { "plan_type": "plus", "distance_km": 5, "has_pick_drop": true }
                },
                "basicPlan": {
                  "summary": "Basic Plan, 3 km",
                  "value": { "plan_type": "basic", "distance_km": 3, "has_pick_drop": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fee calculation result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CalculateFeeResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AvailabilityResponse": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "operating_hours": {
            "type": "object",
            "properties": {
              "start": { "type": "string", "example": "08:00" },
              "end": { "type": "string", "example": "20:00" }
            }
          },
          "slot_duration_min": { "type": "integer", "example": 30 },
          "available_slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": { "type": "string", "example": "08:00:00" },
                "display": { "type": "string", "example": "8:00 AM" }
              }
            }
          },
          "blocked_slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": { "type": "string" },
                "display": { "type": "string" },
                "reason": { "type": "string", "example": "Booked" }
              }
            }
          },
          "total_slots": { "type": "integer", "example": 24 },
          "available_count": { "type": "integer" },
          "blocked_count": { "type": "integer" }
        }
      },
      "BookingRequest": {
        "type": "object",
        "required": ["customer_name", "phone_number", "slot_time", "course_start_date", "duration_days", "plan_type"],
        "properties": {
          "customer_name": { "type": "string" },
          "phone_number": { "type": "string" },
          "slot_time": {
            "type": "string",
            "description": "Preferred daily training time (HH:MM, must be on 30-min boundary)",
            "example": "12:30"
          },
          "course_start_date": {
            "type": "string",
            "format": "date",
            "description": "First day of the course"
          },
          "duration_days": {
            "type": "integer",
            "description": "Total course duration (7 for Basic, 10 for PLUS, 15 for PRO+)",
            "example": 10
          },
          "plan_type": {
            "type": "string",
            "enum": ["basic", "plus", "pro"]
          },
          "distance_km": {
            "type": "number",
            "description": "One-way distance for pick & drop (max 20)",
            "example": 3
          },
          "pickup_address": { "type": "string" },
          "area": { "type": "string" },
          "course_fee": { "type": "number" },
          "distance_fee": { "type": "number" },
          "total_fee": { "type": "number" },
          "notes": { "type": "string" }
        }
      },
      "BookingResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "bookingId": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
          "travel_time_min": {
            "type": "integer",
            "description": "One-way travel time calculated from distance"
          },
          "whatsappLink": { "type": "string", "format": "uri" }
        }
      },
      "CalculateFeeRequest": {
        "type": "object",
        "properties": {
          "plan_type": { "type": "string", "enum": ["basic", "plus", "pro"] },
          "course_fee": { "type": "number" },
          "total_days": { "type": "integer" },
          "distance_km": { "type": "number" },
          "has_pick_drop": { "type": "boolean" }
        }
      },
      "CalculateFeeResponse": {
        "type": "object",
        "properties": {
          "plan": { "type": "string" },
          "planType": { "type": "string" },
          "courseFee": { "type": "number" },
          "distanceFee": { "type": "number" },
          "totalFee": { "type": "number" },
          "breakdown": { "type": "object" },
          "formula": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "details": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ConflictResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string", "example": "SLOT_CONFLICT" }
        }
      }
    }
  }
}
